{
  "info": {
    "name": "PropertEase API",
    "description": "Owner-scoped API. Run signup and login first. Login captures the JWT; create captures projectId. Use fresh demo credentials for signup. See docs/api-contract.md for validation and upload limits.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email",
      "value": "ada@example.com"
    },
    {
      "key": "password",
      "value": "a-long-demo-password"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/signup",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Example\",\n  \"phone\": \"0123456789\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login_check",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authenticated', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/project",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Garden Homes\",\n  \"label\": \"Residential\",\n  \"numberOfFloors\": 3,\n  \"address\": \"12 Garden Street\",\n  \"postalCode\": \"01234\",\n  \"deliveryDate\": \"2027-06-30 12:00:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('projectId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/project?page=1&limit=20"
      }
    },
    {
      "name": "Search projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/project/search?name=Garden&deliveryDateMin=2027-01-01%2000%3A00%3A00&deliveryDateMax=2027-12-31%2023%3A59%3A59&page=1&limit=20"
      }
    },
    {
      "name": "Read project",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/project/{{projectId}}"
      }
    },
    {
      "name": "Update project",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/project/{{projectId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"Updated Residential\",\n  \"numberOfFloors\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Soft-delete project",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/project/{{projectId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create project with picture",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/project",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Garden Homes",
              "type": "text"
            },
            {
              "key": "label",
              "value": "Residential",
              "type": "text"
            },
            {
              "key": "numberOfFloors",
              "value": "3",
              "type": "text"
            },
            {
              "key": "address",
              "value": "12 Garden Street",
              "type": "text"
            },
            {
              "key": "postalCode",
              "value": "01234",
              "type": "text"
            },
            {
              "key": "deliveryDate",
              "value": "2027-06-30 12:00:00",
              "type": "text"
            },
            {
              "key": "picture",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    }
  ]
}
